{
  "name": "khaleej-rozgar",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "feed": "node --experimental-strip-types --no-warnings scraper/build-feed.ts",
    "test": "node --experimental-strip-types --no-warnings --test tests/core.test.ts",
    "seed": "node scripts/make-seed.js",
    "apk": "node scripts/make-seed.js && expo prebuild --platform android --clean && cd android && gradlew.bat app:assembleRelease",
    "aab": "node scripts/make-seed.js && expo prebuild --platform android --clean && cd android && gradlew.bat app:bundleRelease"
  },
  "dependencies": {

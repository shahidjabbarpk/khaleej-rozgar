    "@expo-google-fonts/noto-sans-devanagari": "^0.4.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-firebase/analytics": "^27.1.1",
    "@react-native-firebase/app": "^27.1.1",
    "@react-native-firebase/app-check": "^27.1.1",
    "@react-native-firebase/messaging": "^27.1.1",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "@react-native-ml-kit/identify-languages": "^2.0.0",
    "@react-native-ml-kit/translate-text": "^0.5.0",
    "@types/react": "~19.2.4",
    "expo": "~57.0.30",
